# TradingMaster desktop config. Rename this file to ".env" (same folder as
# tradingmaster-backend.exe) to customize -- without it, the app runs with
# a local SQLite file (tradingmaster.db, created next to the exe) and
# development-only default secrets, which is fine for trying it out but
# not for anything you'd call production.

# Point at a local PostgreSQL install instead of the SQLite fallback:
# DATABASE_URL=postgresql+asyncpg://tradingmaster:tradingmaster@127.0.0.1:5432/tradingmaster

# Generate real secrets before using this for anything beyond local trial use:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JWT_SECRET_KEY=
# CREDENTIAL_ENCRYPTION_KEY=

# Optional: local nse-yahoo-data service for real NSE historical data.
# YAHOO_DATA_SERVICE_URL=http://127.0.0.1:8800
