# Copy to .env and adjust. Never commit the real .env file.

APP_NAME=TradingMaster
ENVIRONMENT=development

# Local dev without Docker (default): SQLite, zero setup.
DATABASE_URL=sqlite+aiosqlite:///./tradingmaster.db
# Docker / production: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://tradingmaster:tradingmaster@localhost:5432/tradingmaster

REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts broker credentials at rest. MUST be changed and kept secret for
# anything beyond local dev with mock brokers.
CREDENTIAL_ENCRYPTION_KEY=hkGwj1XN4gz1Fh0S0e8OqjF5m9jK3vY0Wc7hZzYw6yQ=

CORS_ORIGINS=["http://localhost:3000"]

SEED_ADMIN_EMAIL=admin@tradingmaster.internal
SEED_ADMIN_PASSWORD=ChangeMe123!
