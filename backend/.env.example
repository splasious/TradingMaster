# Copy to .env and adjust. Never commit the real .env file.

APP_NAME=TradingMaster
ENVIRONMENT=development

# PostgreSQL (default) -- matches production and handles the concurrent
# writes the Data Backfill Platform's bulk/live-sync jobs generate; SQLite
# serializes all writes and will report "database is locked" under load.
DATABASE_URL=postgresql+asyncpg://tradingmaster:tradingmaster@localhost:5432/tradingmaster
# Zero-setup local dev without Postgres installed: SQLite. Fine for light
# use, but expect lock contention once the backfill scheduler is running
# alongside real request traffic.
# DATABASE_URL=sqlite+aiosqlite:///./tradingmaster.db

REDIS_URL=redis://localhost:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts broker credentials at rest. MUST be changed and kept secret for
# anything beyond local dev with mock brokers.
CREDENTIAL_ENCRYPTION_KEY=hkGwj1XN4gz1Fh0S0e8OqjF5m9jK3vY0Wc7hZzYw6yQ=

CORS_ORIGINS=["http://localhost:3000"]

SEED_ADMIN_EMAIL=admin@tradingmaster.internal
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional. If set, `python -m app.seed` provisions a Delta Exchange broker
# account for the seed admin using these, encrypted at rest via
# CREDENTIAL_ENCRYPTION_KEY before ever reaching the database. Requires
# this key's IP restriction (Delta Exchange > Account > API Management) to
# include the machine actually running this backend. Leave both unset to
# connect a broker through Settings > Brokers in the UI instead.
# DELTA_API_KEY=
# DELTA_API_SECRET=
